# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# BigQuery
BIGQUERY_DATASET=espi_ebi

# Auth (PUL-71)
# Secret used to sign JWT session cookies (HS256). Generate: openssl rand -hex 32
JWT_SECRET=change-me-random-hex
# Full JSON content (one line) of the Firebase Admin SDK service account key.
# Source: key generated for firebase-adminsdk-fbsvc@<project>.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# API key for Identity Toolkit REST sign-in. Server-side only — use the dedicated
# key "puls-gpw-backend-identitytoolkit" (restricted to identitytoolkit.googleapis.com);
# prod value lives in Secret Manager (firebase-web-api-key). Never commit the value.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Email delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-smtp-password
OWNER_EMAIL=your-email@example.com

# Cost report (PUL-125)
# Multiplies the trailing 7-day median of daily gross cost. A day above the
# product is flagged in the subject line. Below 4 days of history nothing is
# ever flagged, whatever this is set to.
COST_ANOMALY_FACTOR=2.0
# Public URL the report mail's logo resolves against. Same value as the scraper
# job's; defaults to the run.app URL in code, so leaving it unset is fine.
APP_BASE_URL=https://puls-gpw-api-5zlombicra-lm.a.run.app
